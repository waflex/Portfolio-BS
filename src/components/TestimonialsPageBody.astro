---
import { useTranslation } from "../i18n";
import { API_BASE } from "../lib/config";

const { lang = "es" } = Astro.props;
const t = useTranslation(lang);
const tp = (key) => t("testimonials_page." + key);
const isEn = lang === "en";

const sources = [
  { value: "", label: tp("source_default"), disabled: true },
  { value: "whatsapp", label: tp("source_whatsapp") },
  { value: "instagram", label: tp("source_instagram") },
  { value: "x", label: tp("source_x") },
  { value: "linkedin", label: tp("source_linkedin") },
  { value: "github", label: tp("source_github") },
  { value: "referral", label: tp("source_referral") },
  { value: "google", label: tp("source_google") },
  { value: "other", label: tp("source_other") },
];
---

<main class="pt-[70px]" data-api={API_BASE} data-lang={lang}>
  <!-- Hero -->
  <section class="py-20 text-center" style="background: var(--bg-dark);">
    <div class="container mx-auto px-6 lg:px-10">
      <p class="section-label mb-3 animate-fade-up stagger-1">{tp("hero_label")}</p>
      <div class="divider-accent mx-auto mb-5"></div>
      <h1 class="font-display text-white uppercase text-5xl lg:text-7xl mb-4 animate-fade-up stagger-2">
        {tp("hero_title")}
      </h1>
      <p class="font-body text-gray-400 text-base max-w-lg mx-auto animate-fade-up stagger-3">
        {tp("hero_description")}
      </p>
    </div>
  </section>

  <!-- Formulario -->
  <section class="py-16" style="background-color: #0a0a0a;">
    <div class="container mx-auto px-6 lg:px-10 max-w-2xl">
      <div class="card-glass p-8 animate-fade-up">
        <h2 class="font-body font-bold text-white text-xl mb-6">{tp("form_title")}</h2>

        <form id="testimonialForm" class="space-y-5">
          <div>
            <label for="field-name" class="font-body text-xs font-medium mb-2 block" style="color: var(--text-muted);">{tp("name_label")}</label>
            <input type="text" id="field-name" required minlength="1" maxlength="60" placeholder={tp("name_placeholder")} class="form-input" />
          </div>

          <div>
            <label for="field-email" class="font-body text-xs font-medium mb-2 block" style="color: var(--text-muted);">{tp("email_label")}</label>
            <input type="email" id="field-email" required placeholder={tp("email_placeholder")} class="form-input" />
          </div>

          <div>
            <label for="field-company" class="font-body text-xs font-medium mb-2 block" style="color: var(--text-muted);">{tp("company_label")}</label>
            <input type="text" id="field-company" maxlength="120" placeholder={tp("company_placeholder")} class="form-input" />
          </div>

          <div>
            <label for="field-source" class="font-body text-xs font-medium mb-2 block" style="color: var(--text-muted);">{tp("source_label")}</label>
            <div class="custom-select relative">
              <button type="button" id="source-trigger" class="form-input w-full text-left flex items-center justify-between gap-2" aria-haspopup="listbox" aria-expanded="false">
                <span id="source-value" style="color: var(--text-muted);">{tp("source_default")}</span>
                <i class="fas fa-chevron-down text-xs transition-transform duration-200" style="color: var(--text-muted);"></i>
              </button>
              <ul id="source-options" role="listbox" aria-label={tp("source_label")}
                class="absolute z-50 w-full mt-1 rounded-xl overflow-hidden hidden"
                style="background: #1a1a1a; border: 1px solid var(--border); box-shadow: 0 8px 32px rgba(0,0,0,0.5);">
                {sources.map(s => (
                  <li role="option" aria-selected={s.disabled ? "true" : "false"}
                    data-value={s.value}
                    class="custom-select-option px-4 py-2.5 cursor-pointer text-sm transition-colors duration-150 flex items-center justify-between"
                    style={"color: " + (s.disabled ? "var(--text-muted)" : "var(--text-gray)") + "; " + (s.disabled ? "opacity:0.5;cursor:default;" : "")}
                    aria-disabled={s.disabled ? "true" : undefined}>
                    <span>{s.label}</span>
                    {!s.disabled && <i class="fas fa-check hidden text-xs" style="color: var(--accent);"></i>}
                  </li>
                ))}
              </ul>
            </div>
            <input type="hidden" id="field-source" value="" required />
          </div>

          <div>
            <label for="field-rating" class="font-body text-xs font-medium mb-2 block" style="color: var(--text-muted);">{tp("rating_label")}</label>
            <div class="flex gap-2" id="star-rating">
              {[1,2,3,4,5].map(n => (
                <button type="button" data-value={n}
                  class="star-btn w-10 h-10 rounded-lg flex items-center justify-center text-lg transition-all duration-200"
                  style="border: 1px solid var(--border-icon); color: #555;"
                  onmouseover="this.style.borderColor='#FFD700'; this.style.color='#FFD700';"
                  onmouseout="this.style.borderColor=''; this.style.color=''; if(!this.classList.contains('selected')){this.style.color='#555'; this.style.borderColor='var(--border-icon)';}">
                  <i class="fas fa-star"></i>
                </button>
              ))}
            </div>
            <input type="hidden" id="field-rating" value="0" />
          </div>

          <div>
            <label for="field-message" class="font-body text-xs font-medium mb-2 block" style="color: var(--text-muted);">
              {tp("message_label")} <span class="text-xs" style="color: var(--text-muted);" id="char-count">{tp("char_count")}</span>
            </label>
            <textarea id="field-message" required minlength="10" maxlength="500" rows="4" placeholder={tp("message_placeholder")} class="form-input resize-none"></textarea>
          </div>

          <div class="flex items-start gap-3">
            <input type="checkbox" id="field-consent" required class="mt-1 w-4 h-4 rounded" style="accent-color: var(--accent);" />
            <label for="field-consent" class="font-body text-xs" style="color: var(--text-muted);">{tp("consent_label")}</label>
          </div>

          <div id="form-status" class="hidden">
            <p id="form-success" class="font-body text-sm text-center py-3 rounded-xl hidden"
              style="background: rgba(0,229,160,0.12); color: var(--accent); border: 1px solid rgba(0,229,160,0.3);">
              <span>{tp("success_text")}</span></p>
            <p id="form-error" class="font-body text-sm text-center py-3 rounded-xl hidden"
              style="background: rgba(255,45,85,0.12); color: #ff2d55; border: 1px solid rgba(255,45,85,0.3);">
              <span>{tp("error_send")}</span></p>
          </div>

          <button type="submit" id="submit-btn" class="btn-accent-pill w-full justify-center">
            <i class="fas fa-paper-plane"></i> <span>{tp("submit_text")}</span>
          </button>
        </form>
      </div>
    </div>
  </section>

  <!-- Lista de testimonios aprobados -->
  <section class="py-16" style="background: var(--bg-dark);">
    <div class="container mx-auto px-6 lg:px-10">
      <h2 class="font-body font-bold text-white text-2xl mb-8 text-center" set:html={tp("list_title")}></h2>
      <div id="all-testimonials" class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6 min-h-[100px]">
        <div class="col-span-full flex items-center justify-center py-12">
          <div class="flex items-center gap-3 font-body text-sm" style="color: var(--text-muted);">
            <i class="fas fa-spinner fa-spin"></i>
            <span>{tp("list_loading")}</span>
          </div>
        </div>
      </div>
    </div>
  </section>
</main>

<style is:global>
  .custom-select-option:hover { background: rgba(0, 229, 160, 0.10); }
  .custom-select-option[aria-selected="true"] { background: rgba(0, 229, 160, 0.06); }
</style>

<script>
  (function() {
    const main = document.querySelector("main");
    const API = main.dataset.api;
    const lang = main.dataset.lang || "es";

    const pageT = {
      es: {
        char_count: "({len}/500 caracteres)",
        validation_required: "Completa todos los campos obligatorios.",
        validation_minlength: "El testimonio debe tener al menos 10 caracteres.",
        error_submit: "Error al enviar. Intenta nuevamente.",
        error_connection: "Error de conexi\u00f3n. Verifica tu internet.",
        submit_text: '<i class="fas fa-paper-plane"><\/i><span>Enviar testimonio<\/span>',
        sending_text: "Enviando...",
        list_empty: "A\u00fan no hay testimonios publicados. \u00a1S\u00e9 el primero!",
        list_error: "No se pudieron cargar los testimonios."
      },
      en: {
        char_count: "({len}/500 characters)",
        validation_required: "Complete all required fields.",
        validation_minlength: "The testimonial must be at least 10 characters.",
        error_submit: "Error sending. Try again.",
        error_connection: "Connection error. Check your internet.",
        submit_text: '<i class="fas fa-paper-plane"><\/i><span>Send testimonial<\/span>',
        sending_text: "Sending...",
        list_empty: "No testimonials published yet. Be the first!",
        list_error: "Could not load testimonials."
      }
    };
    const msg = pageT[lang] || pageT.es;

    // ---- Rating stars ----
    let selectedRating = 0;
    const starBtns = document.querySelectorAll(".star-btn");
    const ratingInput = document.getElementById("field-rating");
    starBtns.forEach(btn => {
      btn.addEventListener("click", () => {
        selectedRating = parseInt(btn.dataset.value);
        ratingInput.value = selectedRating;
        starBtns.forEach((s, i) => {
          if (i < selectedRating) {
            s.style.color = "#FFD700"; s.style.borderColor = "#FFD700"; s.classList.add("selected");
          } else {
            s.style.color = "#555"; s.style.borderColor = "var(--border-icon)"; s.classList.remove("selected");
          }
        });
      });
    });

    // ---- Char counter ----
    const msgField = document.getElementById("field-message");
    const charCount = document.getElementById("char-count");
    msgField?.addEventListener("input", () => {
      charCount.textContent = msg.char_count.replace("{len}", msgField.value.length);
    });

    // ---- Custom Select ----
    const trigger = document.getElementById("source-trigger");
    const options = document.getElementById("source-options");
    const valueDisplay = document.getElementById("source-value");
    const hiddenInput = document.getElementById("field-source");
    const chevron = trigger?.querySelector(".fa-chevron-down");
    function closeSelect() { options?.classList.add("hidden"); trigger?.setAttribute("aria-expanded", "false"); chevron?.classList.remove("rotate-180"); }
    function openSelect() { options?.classList.remove("hidden"); trigger?.setAttribute("aria-expanded", "true"); chevron?.classList.add("rotate-180"); }
    trigger?.addEventListener("click", (e) => { e.stopPropagation(); const isOpen = !options?.classList.contains("hidden"); isOpen ? closeSelect() : openSelect(); });
    document.querySelectorAll(".custom-select-option").forEach((opt) => {
      opt.addEventListener("click", () => {
        if (opt.getAttribute("aria-disabled") === "true") return;
        valueDisplay.textContent = opt.textContent.trim();
        valueDisplay.style.color = "#fff";
        hiddenInput.value = opt.dataset.value;
        document.querySelectorAll(".custom-select-option .fa-check").forEach(c => c.classList.add("hidden"));
        const check = opt.querySelector(".fa-check");
        if (check) check.classList.remove("hidden");
        closeSelect();
      });
    });
    document.addEventListener("click", (e) => { if (!e.target.closest(".custom-select")) closeSelect(); });
    document.addEventListener("keydown", (e) => { if (e.key === "Escape") closeSelect(); });

    // ---- Form submit ----
    const form = document.getElementById("testimonialForm");
    const submitBtn = document.getElementById("submit-btn");
    const formStatus = document.getElementById("form-status");
    const formSuccess = document.getElementById("form-success");
    const formError = document.getElementById("form-error");

    form?.addEventListener("submit", async (e) => {
      e.preventDefault();
      if (!submitBtn) return;
      const name = document.getElementById("field-name").value.trim();
      const email = document.getElementById("field-email").value.trim();
      const company = document.getElementById("field-company").value.trim();
      const source = document.getElementById("field-source").value;
      const rating = parseInt(ratingInput.value);
      const message = msgField.value.trim();
      const consent = document.getElementById("field-consent").checked;

      if (!name || !email || !source || rating === 0 || !message || !consent) {
        formError.querySelector("span").textContent = msg.validation_required;
        formStatus?.classList.remove("hidden"); formError?.classList.remove("hidden"); formSuccess?.classList.add("hidden"); return;
      }
      if (message.length < 10) {
        formError.querySelector("span").textContent = msg.validation_minlength;
        formStatus?.classList.remove("hidden"); formError?.classList.remove("hidden"); formSuccess?.classList.add("hidden"); return;
      }

      submitBtn.innerHTML = '<i class="fas fa-spinner fa-spin"><\/i><span>' + msg.sending_text + '<\/span>';
      (submitBtn).disabled = true;

      try {
        const res = await fetch(`${API}/api/testimonials`, {
          method: "POST", headers: { "Content-Type": "application/json" },
          body: JSON.stringify({ name, email, company: company || undefined, source, rating, message, consent }),
        });
        formStatus?.classList.remove("hidden");
        if (res.ok) {
          formSuccess?.classList.remove("hidden"); formError?.classList.add("hidden");
          form.reset(); selectedRating = 0; ratingInput.value = "0";
          starBtns.forEach(s => { s.style.color = "#555"; s.style.borderColor = "var(--border-icon)"; s.classList.remove("selected"); });
          charCount.textContent = msg.char_count.replace("{len}", "0");
          loadApproved();
        } else {
          const err = await res.json().catch(() => ({}));
          formError.querySelector("span").textContent = err.detail || msg.error_submit;
          formError?.classList.remove("hidden"); formSuccess?.classList.add("hidden");
        }
      } catch {
        formStatus?.classList.remove("hidden");
        formError.querySelector("span").textContent = msg.error_connection;
        formError?.classList.remove("hidden"); formSuccess?.classList.add("hidden");
      }
      submitBtn.innerHTML = msg.submit_text;
      (submitBtn).disabled = false;
    });

    // ---- Load approved testimonials ----
    const container = document.getElementById("all-testimonials");
    async function loadApproved() {
      try {
        const res = await fetch(`${API}/api/testimonials`);
        if (!res.ok) throw new Error();
        const data = await res.json();
        if (data.length === 0) {
          container.innerHTML = `<div class="col-span-full text-center py-12"><p class="font-body text-sm" style="color: var(--text-muted);">${msg.list_empty}<\/p><\/div>`;
          return;
        }
        container.innerHTML = data.map(t => `
          <article class="card-glass p-6 flex flex-col">
            <div class="flex gap-0.5 mb-3">${Array.from({ length: 5 }, (_, i) => i < t.rating ? '<i class="fas fa-star" style="color: #FFD700; font-size: 13px;"><\/i>' : '<i class="far fa-star" style="color: #555; font-size: 13px;"><\/i>').join("")}<\/div>
            <blockquote class="font-body text-sm leading-relaxed flex-grow mb-4" style="color: var(--text-gray);">&ldquo;${t.message}&rdquo;<\/blockquote>
            <div class="flex items-center gap-3 pt-4" style="border-top: 1px solid var(--border);">
              <div class="w-10 h-10 rounded-full flex items-center justify-center text-black text-sm font-bold flex-shrink-0" style="background: var(--accent);">${t.name.charAt(0).toUpperCase()}<\/div>
              <div><p class="font-body text-sm font-semibold text-white">${t.name}<\/p>${t.company ? `<p class="font-body text-xs" style="color: var(--text-muted);">${t.company}<\/p>` : ""}<\/div>
            <\/div>
          <\/article>
        `).join("");
      } catch {
        container.innerHTML = `<div class="col-span-full text-center py-12"><p class="font-body text-sm" style="color: var(--text-muted);">${msg.list_error}<\/p><\/div>`;
      }
    }
    loadApproved();
  })();
</script>
