---
const socials = [
  { icon: "fab fa-github", href: "https://github.com/waflex", label: "GitHub" },
  {
    icon: "fab fa-linkedin-in",
    href: "https://www.linkedin.com/in/jonathan-rojas-532b9a146/",
    label: "LinkedIn",
  },
  {
    icon: "fab fa-whatsapp",
    href: "https://wa.me/56930744391",
    label: "WhatsApp",
  },
];
---

<aside
  class="fixed right-5 top-1/2 z-50 hidden lg:flex flex-col items-center gap-3"
  style="transform: translateY(-50%);"
  aria-label="Redes sociales"
>
  {
    socials.map((social) => (
      <a
        href={social.href}
        target="_blank"
        rel="noopener noreferrer"
        aria-label={social.label}
        class="social-icon-btn"
      >
        <i class={social.icon} />
      </a>
    ))
  }

  <!-- Línea vertical decorativa -->
  <div
    class="mt-1"
    style="width: 1px; height: 48px; background: rgba(255,255,255,0.12);"
  >
  </div>
</aside>

<style>
  .social-icon-btn {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 40px;
    height: 40px;
    border-radius: 50%;
    border: 1px solid var(--border-icon);
    color: #888;
    text-decoration: none;
    transition: all 0.2s ease;
    padding: 0;
  }

  .social-icon-btn i {
    display: inline-block;
    font-size: 16px;
    position: relative;
    top:0%;
    left:0%;
    line-height: 1;
  }

  .social-icon-btn:hover {
    border-color: #00e5a0;
    color: #00e5a0;
    box-shadow: 0 0 14px rgba(0, 229, 160, 0.35);
    transform: scale(1.1);
    background: rgba(0, 229, 160, 0.06);
  }
  .social-icon-btn:hover i {
    scale: 1.5;
  }

</style>
