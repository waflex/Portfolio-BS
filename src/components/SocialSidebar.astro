---
const socials = [
  { icon: "fab fa-github", href: "https://github.com/waflex", label: "GitHub" },
  {
    icon: "fab fa-linkedin-in",
    href: "https://www.linkedin.com/in/jonathan-rojas-532b9a146/",
    label: "LinkedIn",
  },
  {
    icon: "fab fa-whatsapp",
    href: "https://wa.me/56930744391",
    label: "WhatsApp",
  },
];
---

<aside
  class="fixed right-5 top-1/2 z-50 hidden lg:flex flex-col items-center gap-3"
  style="transform: translateY(-50%);"
  aria-label="Redes sociales"
>
  {
    socials.map((social) => (
      <a
        href={social.href}
        target="_blank"
        rel="noopener noreferrer"
        aria-label={social.label}
        class="social-icon-btn"
      >
        <i class={social.icon} />
      </a>
    ))
  }

  <!-- Línea vertical decorativa -->
  <div
    class="mt-1"
    style="width: 1px; height: 48px; background: rgba(255,255,255,0.12);"
  >
  </div>
</aside>

<style>
  .social-icon-btn {
    /* Tamaño fijo y centrado perfecto */
    display: flex;
    align-items: center;
    justify-content: center;
    width: 40px;
    height: 40px;
    border-radius: 50%;
    border: 1px solid rgba(255, 255, 255, 0.15);
    color: #888888;
    text-decoration: none;
    transition:
      border-color 0.2s ease,
      color 0.2s ease,
      box-shadow 0.2s ease,
      transform 0.2s ease;
    /* Sin padding extra que desplace el ícono */
    padding: 0;
    line-height: 1;
  }

  /* El ícono FA dentro: tamaño y posición fijos */
  .social-icon-btn i {
    font-size: 15px;
    width: 15px;
    height: 15px;
    display: none;
    line-height: 40px;
    text-align: center;
    /* Evitar que FA agregue margin/padding */
    margin: 0;
    padding: 0;
  }
  .social-icon-btn:hover {
    border-color: #00e5a0;
    color: #00e5a0;
    box-shadow: 0 0 14px rgba(0, 229, 160, 0.35);
    transform: scale(1.1);
    align-items: center;
    justify-content: center;
  }
  .social-icon-btn:hover i {
    display: flex;
    scale: 1.5;
    transform: translate(15%,100%);
  }
</style>
