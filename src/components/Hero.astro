---
import { API_BASE } from "../lib/config";
---

<section
  id="home"
  class="min-h-screen flex items-center relative overflow-hidden pt-[70px]"
  style="background-color: #0a0a0a;"
  data-api={API_BASE}
>
  <!-- Glow de fondo sutil -->
  <div
    class="absolute top-1/3 left-1/4 w-[600px] h-[600px] rounded-full pointer-events-none"
    style="background: radial-gradient(circle, rgba(0,229,160,0.06) 0%, transparent 70%); transform: translate(-50%,-50%);"
  ></div>

  <div class="container mx-auto px-6 lg:px-10 relative z-10 w-full">
    <div class="grid grid-cols-1 lg:grid-cols-12 items-center min-h-[88vh] gap-8">

      <!-- ── Texto ───────────────────────────────── -->
      <div class="lg:col-span-7 relative z-20">

        <!-- Label -->
        <p class="section-label mb-5 animate-fade-up stagger-1">
          DESARROLLADOR FULL STACK & DOCENTE
        </p>

        <!-- Título gigante -->
        <h1
          class="font-display text-white uppercase leading-[0.88] mb-6 animate-fade-up stagger-2"
          style="font-size: clamp(64px, 10vw, 118px); letter-spacing: -2px;"
        >
          JONATHAN<br>
          <span style="color: var(--accent);">ROJAS</span>
        </h1>

        <!-- Descripción -->
        <p
          class="font-body text-gray-400 text-base leading-relaxed mb-8 max-w-[480px] animate-fade-up stagger-3"
        >
          Ingeniero Informático con experiencia en desarrollo de soluciones
          web a medida, automatización de procesos y docencia en tecnología.
          Especializado en JavaScript, React y arquitecturas REST.
        </p>

        <!-- CTAs -->
        <div class="flex flex-wrap gap-4 animate-fade-up stagger-4">
          <a href="#contact" class="btn-accent-pill">
            <span>Contáctame</span>
            <div
              class="w-8 h-8 rounded-full flex items-center justify-center text-sm"
              style="background: rgba(0,0,0,0.3);"
            >
              <i class="fas fa-arrow-right" style="color: var(--accent);"></i>
            </div>
          </a>
          <a href="#projects" class="btn-outline-pill">
            Ver Proyectos
          </a>
        </div>

        <!-- Divisor -->
        <div class="hero-line mt-16 mb-0"></div>
      </div>

      <!-- ── Foto ───────────────────────────────── -->
      <div
        class="lg:col-span-5 relative z-10 flex justify-center
               lg:absolute lg:right-8 lg:top-1/2 lg:-translate-y-1/2"
      >
        <!-- Glow detrás de la foto -->
        <div
          class="absolute inset-0 rounded-full pointer-events-none"
          style="background: radial-gradient(circle, rgba(0,229,160,0.12) 0%, transparent 70%);"
        ></div>

        <img
          src="https://avatars.githubusercontent.com/u/38105133?s=600&u=14b646c6385db7fbfed198bede0b9128b74a039e&v=4"
          alt="Jonathan Rojas"
          class="relative w-full max-w-[420px] mx-auto drop-shadow-2xl"
          style="mix-blend-mode: luminosity; filter: brightness(1.05) contrast(1.05);"
          loading="eager"
        />

        <!-- Tarjeta de experiencia flotante -->
        <div
          class="absolute bottom-10 -left-4 lg:-left-8 rounded-2xl px-5 py-4 animate-glow-pulse"
          style="
            background: rgba(20,20,20,0.90);
            backdrop-filter: blur(12px);
            border: 1px solid var(--border);
            box-shadow: var(--shadow-card);
          "
        >
          <p class="font-display text-white text-3xl leading-none" style="color: var(--accent);">4+</p>
          <p class="font-body text-xs mt-1" style="color: var(--text-muted);">Años de</p>
          <p class="font-body text-xs font-semibold text-white">Experiencia</p>
        </div>

        <!-- Tarjeta de rating flotante -->
        <div
          class="absolute -top-4 right-0 lg:right-4 rounded-2xl px-5 py-4"
          style="
            background: rgba(20,20,20,0.90);
            backdrop-filter: blur(12px);
            border: 1px solid var(--border);
            box-shadow: var(--shadow-card);
          "
        >
          <div class="flex items-center gap-4">
            <div>
              <p id="hero-rating-value" class="font-body text-white text-2xl font-bold leading-none">4.5</p>
              <p class="font-body text-xs mt-0.5" style="color: var(--text-muted);">Valoración clientes</p>
            </div>
            <!-- Avatares apilados -->
            <div id="hero-avatars" class="flex -space-x-2">
              {['#00e5a0','#4f8ef7','#a855f7','#f43f5e'].map(color => (
                <div
                  class="w-8 h-8 rounded-full border-2"
                  style={`background: ${color}; border-color: rgba(20,20,20,0.90);`}
                ></div>
              ))}
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<script>
  (async function loadHeroStats() {
    const section = document.getElementById("home");
    const API = section?.dataset.api;
    if (!API) return;

    try {
      const res = await fetch(`${API}/api/testimonials`);
      if (!res.ok) return;
      const testimonials = await res.json();

      // Solo activar si hay 5+ testimonios aprobados
      if (testimonials.length < 5) return;

      // Rating promedio real
      const avg =
        testimonials.reduce((sum, t) => sum + t.rating, 0) /
        testimonials.length;
      const avgRounded = Math.round(avg * 10) / 10;

      const valEl = document.getElementById("hero-rating-value");
      if (valEl) valEl.textContent = avgRounded.toFixed(1);

      // Avatares con iniciales reales de los primeros testimonios
      const container = document.getElementById("hero-avatars");
      if (container) {
        const colors = ["#00e5a0", "#4f8ef7", "#a855f7", "#f43f5e"];
        container.innerHTML = testimonials
          .slice(0, 4)
          .map(
            (t, i) =>
              `<div
                class="w-8 h-8 rounded-full border-2 flex items-center justify-center text-xs font-bold"
                style="background:${colors[i % colors.length]}; border-color:rgba(20,20,20,0.90); color:#000;"
                title="${t.name}"
              >${t.name.charAt(0).toUpperCase()}</div>`
          )
          .join("");
      }
    } catch {
      // Error de red — mantener fallback
    }
  })();
</script>