---
import { projects } from '../data/projects';
---

<section id="projects" class="py-24" style="background-color: #0a0a0a;">
  <div class="container mx-auto px-6 lg:px-10">

    <!-- Header -->
    <div class="text-center mb-16 animate-fade-up">
      <p class="section-label mb-3">PORTAFOLIO</p>
      <div class="divider-accent mx-auto mb-5"></div>
      <h2 class="section-title text-3xl lg:text-4xl">
        Mis <span style="color: var(--accent);">Proyectos</span>
      </h2>
      <p class="font-body text-gray-400 text-base mt-3 max-w-xl mx-auto">
        Soluciones reales desarrolladas para clientes y proyectos personales.
      </p>
    </div>

    <!-- Grid -->
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
      {projects.map((project, i) => (
        <article
          class="card-glass flex flex-col overflow-hidden animate-fade-up"
          style={`animation-delay: ${i * 0.1}s;`}
        >
          {project.image && (
            <div class="h-48 overflow-hidden relative">
              <img
                src={project.image}
                alt={project.title}
                class="w-full h-full object-cover transition-transform duration-500 hover:scale-110"
                loading="lazy"
              />
            </div>
          )}

          <div class="flex flex-col flex-grow p-6">
            <h3 class="font-body font-bold text-lg text-white mb-2">{project.title}</h3>

            <p
              class="font-body text-sm leading-relaxed mb-5"
              style="color: var(--text-muted); display: -webkit-box; -webkit-line-clamp: 3; -webkit-box-orient: vertical; overflow: hidden;"
            >
              {project.description}
            </p>

            <div class="flex flex-wrap gap-2 mb-6">
              {project.technologies.map(tech => (
                <span class="tech-badge">
                  <i class={`${tech.icon} ${tech.color}`} style="font-size: 13px;"></i>
                  {tech.name}
                </span>
              ))}
            </div>

            <div class="flex gap-3 mt-auto">
              <a href={project.github} target="_blank" rel="noopener noreferrer" class="proj-btn-ghost flex-1">
                <i class="fab fa-github"></i>
                <span>GitHub</span>
              </a>
              {project.demo && (
                <a href={project.demo} target="_blank" rel="noopener noreferrer" class="proj-btn-accent flex-1">
                  <i class="fas fa-external-link-alt"></i>
                  <span>Demo</span>
                </a>
              )}
            </div>
          </div>
        </article>
      ))}
    </div>

    <div class="text-center mt-12">
      <a href="https://github.com/waflex" target="_blank" rel="noopener noreferrer" class="btn-outline-pill">
        <i class="fab fa-github" style="color: var(--accent);"></i>
        Ver más en GitHub
      </a>
    </div>
  </div>
</section>

<style>
  .proj-btn-ghost,
  .proj-btn-accent {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 6px;
    padding: 10px 16px;
    border-radius: 9999px;
    font-family: 'Poppins', sans-serif;
    font-size: 13px;
    font-weight: 600;
    text-decoration: none;
    transition: all 0.2s ease;
    white-space: nowrap;
    line-height: 1;
  }

  .proj-btn-ghost {
    background: rgba(255, 255, 255, 0.05);
    border: 1px solid rgba(255, 255, 255, 0.15);
    color: #cccccc;
  }
  .proj-btn-ghost:hover {
    border-color: #00e5a0;
    color: #00e5a0;
    background: rgba(0, 229, 160, 0.06);
  }

  .proj-btn-accent {
    background: #00e5a0;
    border: 1px solid transparent;
    color: #000;
  }
  .proj-btn-accent:hover {
    background: #00c988;
  }

  /* El ícono dentro del botón, sin ancho variable */
  .proj-btn-ghost i,
  .proj-btn-accent i {
    font-size: 13px;
    width: 14px;
    text-align: center;
    flex-shrink: 0;
    display: none;
  }
  .proj-btn-ghost:hover i,
  .proj-btn-accent:hover i {
    display: block;
    position: relative;
    left: 0%;
    top: 0%;
  }
</style>