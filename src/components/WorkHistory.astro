---
import { workHistory as fallbackWork } from '../data/workHistory';
import { fetchFromAPI } from "../lib/api";
import { useTranslation } from "../i18n";

const { lang = "es" } = Astro.props;
const t = useTranslation(lang);

const apiEndpoint = "/api/work-history" + (lang !== "es" ? "?lang=" + lang : "");
const workHistory = await fetchFromAPI(apiEndpoint, fallbackWork);
---

<section id="work" class="py-24" style="background: var(--bg-dark);">
  <div class="container mx-auto px-6 lg:px-10">

    <!-- Header -->
    <div class="text-center mb-16 animate-fade-up">
      <p class="section-label mb-3">{t("work.label")}</p>
      <div class="divider-accent mx-auto mb-5"></div>
      <h2 class="section-title text-3xl lg:text-4xl">
        {t("work.title")}
      </h2>
      <p class="font-body text-gray-400 text-base mt-3 max-w-xl mx-auto">
        {t("work.description")}
      </p>
    </div>

    <!-- Cards -->
    <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
      {workHistory.map((job, i) => (
        <article
          class="card-glass p-7 flex flex-col animate-fade-up"
          style={`animation-delay: ${i * 0.15}s;`}
        >
          <!-- Header del card -->
          <div class="flex items-start justify-between gap-4 mb-4">
            <div>
              <h3 class="font-body font-bold text-white text-lg leading-tight">{job.title}</h3>
              <p class="font-body text-sm mt-1" style="color: var(--accent);">{job.company}</p>
            </div>
            <!-- Badge periodo -->
            <span
              class="font-body text-xs font-medium px-3 py-1.5 rounded-full flex-shrink-0 mt-1"
              style="background: rgba(0,229,160,0.12); color: var(--accent); border: 1px solid rgba(0,229,160,0.25);"
            >
              {job.period}
            </span>
          </div>

          <!-- Divisor -->
          <div class="divider-accent mb-4"></div>

          <!-- Descripción -->
          <p class="font-body text-sm leading-relaxed mb-5" style="color: var(--text-muted);">
            {job.description}
          </p>

          <!-- Logros -->
          <div class="mb-6 flex-grow">
            <p class="font-body text-xs font-semibold uppercase tracking-wider mb-3 text-white">
              {t("work.achievements_title")}
            </p>
            <ul class="space-y-2">
              {job.achievements.map(ach => (
                <li class="flex items-start gap-3">
                  <div class="timeline-dot mt-[6px]"></div>
                  <span class="font-body text-sm" style="color: var(--text-gray);">{ach}</span>
                </li>
              ))}
            </ul>
          </div>

          <!-- Tecnologías -->
          <div class="flex flex-wrap gap-2">
            {job.technologies.map(tech => (
              <span class="tech-badge">
                <i class={`${tech.icon} ${tech.color} text-sm`}></i>
                {tech.name}
              </span>
            ))}
          </div>
        </article>
      ))}
    </div>
  </div>
</section>

<style>
.tech-badge i {
  vertical-align: middle;
}
</style>