---
---
<section class="mb-10 text-center mx-auto max-w-7xl px-4">
  <h3 class="titulo">Historial de Trabajo</h3>
  <div class="flex justify-center">
    <div class="w-full max-w-4xl space-y-6">
      <div class="card backdrop-blur-sm hover:shadow-[0_0_5px_rgb(0_255_255),0_0_20px_rgb(0_255_255)] transition-all duration-300">
        <div class="card-body">
          <h4 class="card-title text-xl bg-gradient-to-r from-neon-pink to-neon-blue bg-clip-text text-transparent">
            Encargado de TI
          </h4>
          <h5 class="text-lg opacity-90 mb-2 text-neon-blue">
            Instituto Profesional Valle Central Sede La Serena | 2019 - Presente
          </h5>
          <ul class="text-base-content/80 text-left space-y-2">
            <li class="flex items-start gap-2">
              <i class="fas fa-chevron-right text-neon-pink mt-1"></i>
              <span>Gestión y mantenimiento de infraestructura TI de la sede</span>
            </li>
            <li class="flex items-start gap-2">
              <i class="fas fa-chevron-right text-neon-pink mt-1"></i>
              <span>Desarrollo de herramientas web para optimización de procesos internos</span>
            </li>
            <li class="flex items-start gap-2">
              <i class="fas fa-chevron-right text-neon-pink mt-1"></i>
              <span>Soporte técnico y capacitación a personal y estudiantes</span>
            </li>
          </ul>
        </div>
      </div>
      
      <div class="card backdrop-blur-sm hover:shadow-[0_0_5px_rgb(0_255_255),0_0_20px_rgb(0_255_255)] transition-all duration-300">
        <div class="card-body">
          <h4 class="card-title text-xl bg-gradient-to-r from-neon-pink to-neon-blue bg-clip-text text-transparent">
            Desarrollador Full Stack
          </h4>
          <h5 class="text-lg opacity-90 mb-2 text-neon-blue">
            Freelancer | 2015 - Presente
          </h5>
          <ul class="text-base-content/80 text-left space-y-2">
            <li class="flex items-start gap-2">
              <i class="fas fa-chevron-right text-neon-pink mt-1"></i>
              <span>Desarrollo de aplicaciones web personalizadas para sectores gubernamentales y educativos</span>
            </li>
            <li class="flex items-start gap-2">
              <i class="fas fa-chevron-right text-neon-pink mt-1"></i>
              <span>Implementación de soluciones usando ReactJs, JavaScript y arquitecturas REST</span>
            </li>
            <li class="flex items-start gap-2">
              <i class="fas fa-chevron-right text-neon-pink mt-1"></i>
              <span>Gestión de proyectos y comunicación directa con clientes</span>
            </li>
          </ul>
        </div>
      </div>
    </div>
  </div>
</section>