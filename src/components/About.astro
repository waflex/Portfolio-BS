---
import { Image } from "astro:assets";
import heroImg from "../assets/img/Jonathan-Rojas.avif";
import { useTranslation } from "../i18n";

const { lang = "es" } = Astro.props;
const t = useTranslation(lang);

const skills = [
  "JavaScript & TypeScript",
  "React & Node.js",
  "REST APIs & Express",
  "MySQL & MongoDB",
  "PHP & Python",
  "Redes & Linux",
  "Metodologías Ágiles",
  "Docencia Técnica",
];
---

<section
  id="about"
  class="py-24"
  style="background: var(--bg-dark);"
>
  <div class="container mx-auto px-6 lg:px-10">
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-16 items-center">

      <!-- ── Foto con blob ──────────────────────── -->
      <div class="lg:col-span-5 relative animate-fade-up">
        <!-- Blob verde orgánico animado -->
        <div
          class="absolute inset-4 animate-blob"
          style="background: rgba(0,229,160,0.15); z-index: 0;"
        ></div>

        <!-- Foto -->
        <Image
          src={heroImg}
          alt="Jonathan Rojas"
          width={600}
          height={600}
          class="relative z-10 w-full max-w-[380px] mx-auto rounded-2xl object-cover"
          style="box-shadow: var(--shadow-card);"
          loading="lazy"
        />

        <!-- Badge experiencia -->
        <div
          class="absolute -bottom-4 -left-4 z-20 rounded-2xl px-5 py-4"
          style="
            background: rgba(10,10,10,0.95);
            border: 1px solid var(--border);
            box-shadow: var(--shadow-glow);
          "
        >
          <p class="font-display text-4xl leading-none" style="color: var(--accent);">5+</p>
          <p class="font-body text-xs mt-1 text-white font-medium">{t("about.years_badge")}</p>
        </div>

        <!-- Badge docencia -->
        <div
          class="absolute -top-4 -right-4 z-20 rounded-2xl px-4 py-3"
          style="
            background: rgba(10,10,10,0.95);
            border: 1px solid var(--border);
          "
        >
          <p class="font-body text-xs" style="color: var(--text-muted);">{t("about.teacher_badge")}</p>
          <p class="font-body text-sm font-bold text-white">AIEP · IPCHILE</p>
        </div>
      </div>

      <!-- ── Texto ──────────────────────────────── -->
      <div class="lg:col-span-7 animate-fade-up stagger-2">

        <!-- Label -->
        <p class="section-label mb-3">{t("about.label")}</p>
        <div class="divider-accent mb-5"></div>

        <!-- Título -->
        <h2 class="section-title text-3xl lg:text-4xl mb-5">
          {t("about.title_line1")}<br>
          <span style="color: var(--accent);">{t("about.title_line2")}</span> {t("about.title_line3")}
        </h2>

        <!-- Descripción -->
        <p class="font-body text-gray-400 text-base leading-relaxed mb-4">
          {t("about.p1")}
        </p>
        <p class="font-body text-gray-400 text-base leading-relaxed mb-8" set:html={t("about.p2")}>
        </p>

        <!-- Skills grid -->
        <div class="grid grid-cols-2 gap-3 mb-8">
          {skills.map(skill => (
            <div class="check-item">
              <div class="check-box">
                <i class="fas fa-check"></i>
              </div>
              <span class="font-body text-sm" style="color: var(--text-gray);">{skill}</span>
            </div>
          ))}
        </div>

        <!-- CTAs -->
        <div class="flex flex-wrap gap-4">
          <a href={lang !== "es" ? `/${lang}/#contact` : "#contact"} class="btn-accent-pill">
            <span>{t("about.cta_work")}</span>
            <div
              class="w-7 h-7 rounded-full flex items-center justify-center"
              style="background: rgba(0,0,0,0.3);"
            >
              <i class="fas fa-arrow-right text-xs" style="color: var(--accent);"></i>
            </div>
          </a>
          <a
            href={lang === "es" ? "/assets/files/CVJRES.pdf" : "/assets/files/CVJREN.pdf"}
            download
            class="btn-outline-pill"
          >
            <i class="fas fa-file-download text-xs" style="color: var(--accent);"></i>
            {t("about.download_cv")}
          </a>
        </div>
      </div>
    </div>
  </div>
</section>