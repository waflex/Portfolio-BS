---
import { teachingHistory } from '../data/workHistory';
---

<section id="teaching" class="py-24" style="background-color: #0a0a0a;">
  <div class="container mx-auto px-6 lg:px-10">

    <!-- Header -->
    <div class="text-center mb-16 animate-fade-up">
      <p class="section-label mb-3">FORMACIÓN & CONSULTORÍA</p>
      <div class="divider-accent mx-auto mb-5"></div>
      <h2 class="section-title text-3xl lg:text-4xl">
        Docencia &amp; <span style="color: var(--accent);">Consultoría</span>
      </h2>
      <p class="font-body text-gray-400 text-base mt-3 max-w-xl mx-auto">
        Formando a la próxima generación de desarrolladores y apoyando
        organizaciones con soluciones tecnológicas.
      </p>
    </div>

    <!-- Cards -->
    <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
      {teachingHistory.map((job, i) => (
        <article
          class="card-glass p-7 flex flex-col animate-fade-up"
          style={`animation-delay: ${i * 0.15}s;`}
        >
          <!-- Ícono de rol -->
          <div class="flex items-start gap-4 mb-4">
            <div
              class="w-12 h-12 rounded-xl flex items-center justify-center flex-shrink-0 text-black text-xl"
              style="background: var(--accent);"
            >
              <i class={job.title === 'Docente' ? 'fas fa-chalkboard-teacher' : 'fas fa-headset'}></i>
            </div>
            <div>
              <h3 class="font-body font-bold text-white text-lg">{job.title}</h3>
              <p class="font-body text-sm" style="color: var(--accent);">{job.company}</p>
            </div>
            <span
              class="ml-auto font-body text-xs font-medium px-3 py-1.5 rounded-full flex-shrink-0"
              style="background: rgba(0,229,160,0.12); color: var(--accent); border: 1px solid rgba(0,229,160,0.25);"
            >
              {job.period}
            </span>
          </div>

          <div class="divider-accent mb-4"></div>

          <p class="font-body text-sm leading-relaxed mb-5" style="color: var(--text-muted);">
            {job.description}
          </p>

          <!-- Actividades -->
          <div class="mb-6 flex-grow">
            <p class="font-body text-xs font-semibold uppercase tracking-wider mb-3 text-white">
              Actividades principales
            </p>
            <ul class="space-y-2">
              {job.activities.map(act => (
                <li class="flex items-start gap-3">
                  <div class="timeline-dot mt-[6px]"></div>
                  <span class="font-body text-sm" style="color: var(--text-gray);">{act}</span>
                </li>
              ))}
            </ul>
          </div>

          <!-- Tecnologías -->
          <div class="flex flex-wrap gap-2">
            {job.technologies.map(tech => (
              <span class="tech-badge">
                <i class={`${tech.icon} ${tech.color} text-sm`}></i>
                {tech.name}
              </span>
            ))}
          </div>
        </article>
      ))}
    </div>
  </div>
</section>