---
import { teachingHistory } from '../data/workHistory';
---
<section class="mb-10 text-center mx-auto max-w-7xl px-4">
  <h3 class="titulo mb-8">Experiencia en Docencia y Consultoría</h3>
  <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
    {
      teachingHistory.map((job) => (
        <div class="card backdrop-blur-sm hover:shadow-[0_0_5px_rgb(0_255_255),0_0_20px_rgb(0_255_255)] transition-all duration-300 h-full flex flex-col">
          <div class="card-body flex flex-col flex-grow">
            <h4 class="card-title text-xl bg-gradient-to-r from-neon-pink to-neon-blue bg-clip-text text-transparent">
              {job.title}
            </h4>
            <h5 class="text-lg opacity-90 mb-2 text-neon-blue">
              {job.company} | {job.period}
            </h5>
            <p class="text-base-content/80 mb-4">{job.description}</p>
            <div class="mb-4">
              <h6 class="text-left text-neon-pink mb-2">Actividades:</h6>
              <ul class="text-left space-y-2">
                {job.achievements.map((achievement) => (
                  <li class="flex items-start gap-2">
                    <i class="fas fa-chevron-right text-neon-pink mt-1"></i>
                    <span>{achievement}</span>
                  </li>
                ))}
              </ul>
            </div>
            <div class="flex flex-wrap gap-2 mt-auto">
              <h6 class="w-full text-left text-neon-pink mb-2">Tecnologías:</h6>
              {job.technologies.map((tech) => (
                <span class="badge badge-outline gap-2 px-3 py-3">
                  <i class={`${tech.icon} ${tech.color}`}></i>
                  {tech.name}
                </span>
              ))}
            </div>
          </div>
        </div>
      ))
    }
  </div>
</section>