---
import Layout from "../../layouts/Layout.astro";
import Navbar from "../../components/Navbar.astro";
import Footer from "../../components/Footer.astro";
import TestimonialsPageBody from "../../components/TestimonialsPageBody.astro";

export async function getStaticPaths() {
  return [
    { params: { lang: "es" } },
    { params: { lang: "en" } },
  ];
}

const { lang } = Astro.params;
const title = lang === "en"
  ? "Testimonials — Jonathan Rojas | JRTdev"
  : "Testimonios — Jonathan Rojas | JRTdev";
const desc = lang === "en"
  ? "Leave your testimonial or read what other clients say about my work."
  : "Deja tu testimonio o lee lo que otros clientes dicen sobre mi trabajo.";
---

<Layout title={title} description={desc} lang={lang}>
  <Navbar lang={lang} />
  <TestimonialsPageBody lang={lang} />
  <Footer lang={lang} />
</Layout>
