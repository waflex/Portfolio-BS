---
import Layout from "../../layouts/Layout.astro";
import { API_BASE } from "../../lib/config";
---

<Layout title="Admin — Testimonios | JRTdev">
  <main class="min-h-screen pt-[70px]" style="background-color: #0a0a0a;">
    <div class="container mx-auto px-6 lg:px-10 py-12">
      <div id="app" data-api={API_BASE}>
        <!-- Login -->
        <div id="login-view" class="max-w-sm mx-auto">
          <div class="card-glass p-8">
            <h1 class="font-body font-bold text-white text-xl mb-2">Admin</h1>
            <p class="font-body text-sm mb-6" style="color: var(--text-muted);">Ingresa tu contraseña para gestionar testimonios.</p>
            <form id="login-form" class="space-y-4">
              <input type="password" id="login-password" placeholder="Contraseña" class="form-input" required />
              <p id="login-error" class="font-body text-xs hidden" style="color: #ff2d55;">Contraseña incorrecta.</p>
              <button type="submit" id="login-btn" class="btn-accent-pill w-full justify-center">
                <i class="fas fa-lock"></i>
                <span>Entrar</span>
              </button>
            </form>
          </div>
        </div>

        <!-- Dashboard -->
        <div id="dashboard-view" class="hidden">
          <div class="flex items-center justify-between mb-8">
            <div>
              <h1 class="font-body font-bold text-white text-2xl">Gestión de Testimonios</h1>
              <p class="font-body text-sm" style="color: var(--text-muted);" id="stats-summary">Cargando...</p>
            </div>
            <button id="logout-btn" class="btn-outline-pill text-sm px-4 py-2">
              <i class="fas fa-sign-out-alt"></i>
              Salir
            </button>
          </div>

          <!-- Filtros -->
          <div class="flex flex-wrap gap-3 mb-6">
            <button class="filter-btn active" data-filter="all" style="background: var(--accent); color: #000; border: none; padding: 8px 20px; border-radius: 9999px; font-family: Poppins, sans-serif; font-size: 13px; font-weight: 600; cursor: pointer; transition: all 0.2s;">Todos</button>
            <button class="filter-btn" data-filter="pending" style="background: rgba(255,179,0,0.15); color: #ffb300; border: 1px solid rgba(255,179,0,0.3); padding: 8px 20px; border-radius: 9999px; font-family: Poppins, sans-serif; font-size: 13px; font-weight: 500; cursor: pointer; transition: all 0.2s;">Pendientes</button>
            <button class="filter-btn" data-filter="approved" style="background: rgba(0,229,160,0.12); color: var(--accent); border: 1px solid rgba(0,229,160,0.25); padding: 8px 20px; border-radius: 9999px; font-family: Poppins, sans-serif; font-size: 13px; font-weight: 500; cursor: pointer; transition: all 0.2s;">Aprobados</button>
            <button class="filter-btn" data-filter="rejected" style="background: rgba(255,45,85,0.12); color: #ff2d55; border: 1px solid rgba(255,45,85,0.25); padding: 8px 20px; border-radius: 9999px; font-family: Poppins, sans-serif; font-size: 13px; font-weight: 500; cursor: pointer; transition: all 0.2s;">Rechazados</button>
          </div>

          <!-- Tabla -->
          <div class="card-glass overflow-hidden">
            <div class="overflow-x-auto">
              <table class="w-full text-left">
                <thead>
                  <tr style="border-bottom: 1px solid var(--border); background: rgba(255,255,255,0.03);">
                    <th class="font-body text-xs font-semibold uppercase tracking-wider px-4 py-3" style="color: var(--text-muted);">Fecha</th>
                    <th class="font-body text-xs font-semibold uppercase tracking-wider px-4 py-3" style="color: var(--text-muted);">Nombre</th>
                    <th class="font-body text-xs font-semibold uppercase tracking-wider px-4 py-3" style="color: var(--text-muted);">Rating</th>
                    <th class="font-body text-xs font-semibold uppercase tracking-wider px-4 py-3" style="color: var(--text-muted);">Origen</th>
                    <th class="font-body text-xs font-semibold uppercase tracking-wider px-4 py-3" style="color: var(--text-muted);">Mensaje</th>
                    <th class="font-body text-xs font-semibold uppercase tracking-wider px-4 py-3" style="color: var(--text-muted);">Estado</th>
                    <th class="font-body text-xs font-semibold uppercase tracking-wider px-4 py-3" style="color: var(--text-muted);">Acciones</th>
                  </tr>
                </thead>
                <tbody id="table-body">
                  <tr>
                    <td colspan="7" class="text-center py-8 font-body text-sm" style="color: var(--text-muted);">
                      <i class="fas fa-spinner fa-spin"></i> Cargando...
                    </td>
                  </tr>
                </tbody>
              </table>
            </div>
          </div>

          <!-- Métricas de origen -->
          <div class="card-glass p-6 mt-8">
            <h3 class="font-body font-bold text-white text-lg mb-4">📊 Origen de contactos</h3>
            <div id="source-metrics" class="grid grid-cols-2 md:grid-cols-4 gap-4">
              Cargando...
            </div>
          </div>
        </div>
      </div>
    </div>
  </main>
</Layout>

<script>
  const API = document.getElementById("app").dataset.api;
  let token = localStorage.getItem("jrtdev_admin_token") || "";
  let allTestimonials = [];
  let currentFilter = "all";

  // ---- Login ----
  const loginView = document.getElementById("login-view");
  const dashboardView = document.getElementById("dashboard-view");
  const loginForm = document.getElementById("login-form");
  const loginError = document.getElementById("login-error");
  const loginBtn = document.getElementById("login-btn");

  // Check if already logged in
  if (token) {
    loginView.classList.add("hidden");
    dashboardView.classList.remove("hidden");
    loadData();
  }

  loginForm?.addEventListener("submit", async (e) => {
    e.preventDefault();
    const password = document.getElementById("login-password").value;
    loginBtn.innerHTML = '<i class="fas fa-spinner fa-spin"></i><span>Entrando...</span>';
    (loginBtn).disabled = true;

    try {
      const res = await fetch(`${API}/api/admin/login`, {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify({ password }),
      });
      if (res.ok) {
        const data = await res.json();
        token = data.token;
        localStorage.setItem("jrtdev_admin_token", token);
        loginView.classList.add("hidden");
        dashboardView.classList.remove("hidden");
        loadData();
      } else {
        loginError.classList.remove("hidden");
      }
    } catch {
      loginError.classList.remove("hidden");
      loginError.textContent = "Error de conexión con la API.";
    }

    loginBtn.innerHTML = '<i class="fas fa-lock"></i><span>Entrar</span>';
    (loginBtn).disabled = false;
  });

  // ---- Logout ----
  document.getElementById("logout-btn")?.addEventListener("click", () => {
    token = "";
    localStorage.removeItem("jrtdev_admin_token");
    dashboardView.classList.add("hidden");
    loginView.classList.remove("hidden");
    document.getElementById("login-password").value = "";
    loginError.classList.add("hidden");
  });

  // ---- Load data ----
  async function loadData() {
    try {
      const res = await fetch(`${API}/api/admin/testimonials`, {
        headers: { Authorization: `Bearer ${token}` },
      });
      if (res.status === 401) {
        // Token expired
        localStorage.removeItem("jrtdev_admin_token");
        token = "";
        dashboardView.classList.add("hidden");
        loginView.classList.remove("hidden");
        return;
      }
      if (!res.ok) throw new Error();
      allTestimonials = await res.json();
      renderAll();
    } catch {
      document.getElementById("table-body").innerHTML = `
        <tr><td colspan="7" class="text-center py-8 font-body text-sm" style="color: #ff2d55;">
          Error al cargar datos. Verifica que la API esté corriendo.
        </td></tr>
      `;
    }
  }

  // ---- Render ----
  function renderAll() {
    renderStats();
    renderTable();
    renderSourceMetrics();
  }

  function renderStats() {
    const pending = allTestimonials.filter(t => t.status === "pending").length;
    const approved = allTestimonials.filter(t => t.status === "approved").length;
    const rejected = allTestimonials.filter(t => t.status === "rejected").length;
    document.getElementById("stats-summary").textContent =
      `${allTestimonials.length} totales · ${pending} pendientes · ${approved} aprobados · ${rejected} rechazados`;
  }

  function renderTable() {
    const tbody = document.getElementById("table-body");
    const filtered = currentFilter === "all"
      ? allTestimonials
      : allTestimonials.filter(t => t.status === currentFilter);

    if (filtered.length === 0) {
      tbody.innerHTML = `
        <tr><td colspan="7" class="text-center py-8 font-body text-sm" style="color: var(--text-muted);">
          No hay testimonios con este filtro.
        </td></tr>
      `;
      return;
    }

    tbody.innerHTML = filtered.map(t => `
      <tr style="border-bottom: 1px solid var(--border);">
        <td class="px-4 py-3 font-body text-xs" style="color: var(--text-muted); white-space: nowrap;">
          ${new Date(t.created_at).toLocaleDateString("es-CL")}
        </td>
        <td class="px-4 py-3">
          <div class="font-body text-sm font-medium text-white">${t.name}</div>
          <div class="font-body text-xs" style="color: var(--text-muted);">${t.email}</div>
          ${t.company ? `<div class="font-body text-xs" style="color: var(--accent);">${t.company}</div>` : ""}
        </td>
        <td class="px-4 py-3 font-body text-sm" style="color: #FFD700;">
          ${"★".repeat(t.rating)}${"☆".repeat(5 - t.rating)}
        </td>
        <td class="px-4 py-3 font-body text-xs" style="color: var(--text-gray);">
          ${t.source}
        </td>
        <td class="px-4 py-3 font-body text-sm" style="color: var(--text-gray); max-width: 240px;">
          <div style="display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden;">
            ${t.message}
          </div>
        </td>
        <td class="px-4 py-3">
          ${statusBadge(t)}
        </td>
        <td class="px-4 py-3">
          <div class="flex flex-wrap gap-2">
            ${actionButtons(t)}
          </div>
        </td>
      </tr>
    `).join("");

    // Attach event listeners
    tbody.querySelectorAll("[data-action]").forEach(btn => {
      btn.addEventListener("click", async () => {
        const id = btn.dataset.id;
        const action = btn.dataset.action;
        await performAction(id, action, btn.dataset.featured === "true");
      });
    });
  }

  function statusBadge(t) {
    const colors = {
      pending: { bg: "rgba(255,179,0,0.12)", text: "#ffb300", border: "rgba(255,179,0,0.25)" },
      approved: { bg: "rgba(0,229,160,0.12)", text: "var(--accent)", border: "rgba(0,229,160,0.25)" },
      rejected: { bg: "rgba(255,45,85,0.12)", text: "#ff2d55", border: "rgba(255,45,85,0.25)" },
    };
    const c = colors[t.status] || colors.pending;
    let label = t.status === "pending" ? "Pendiente" : t.status === "approved" ? "Aprobado" : "Rechazado";
    if (t.featured) label += " ⭐";
    return `<span class="font-body text-xs font-medium px-2.5 py-1 rounded-full" style="background: ${c.bg}; color: ${c.text}; border: 1px solid ${c.border};">${label}</span>`;
  }

  function actionButtons(t) {
    if (t.status === "pending") {
      return `
        <button data-action="approve" data-id="${t.id}" data-featured="false"
          class="font-body text-xs font-semibold px-3 py-1.5 rounded-full transition-all duration-200"
          style="background: rgba(0,229,160,0.12); color: var(--accent); border: 1px solid rgba(0,229,160,0.25); cursor: pointer;">
          ✅ Aprobar
        </button>
        <button data-action="approve" data-id="${t.id}" data-featured="true"
          class="font-body text-xs font-semibold px-3 py-1.5 rounded-full transition-all duration-200"
          style="background: rgba(0,229,160,0.12); color: var(--accent); border: 1px solid rgba(0,229,160,0.25); cursor: pointer;">
          ⭐ Aprobar ⭐
        </button>
        <button data-action="reject" data-id="${t.id}"
          class="font-body text-xs font-semibold px-3 py-1.5 rounded-full transition-all duration-200"
          style="background: rgba(255,45,85,0.12); color: #ff2d55; border: 1px solid rgba(255,45,85,0.25); cursor: pointer;">
          ✕ Rechazar
        </button>
      `;
    }
    if (t.status === "approved") {
      return `
        <button data-action="reject" data-id="${t.id}"
          class="font-body text-xs font-semibold px-3 py-1.5 rounded-full transition-all duration-200"
          style="background: rgba(255,45,85,0.12); color: #ff2d55; border: 1px solid rgba(255,45,85,0.25); cursor: pointer;">
          ✕ Rechazar
        </button>
      `;
    }
    // rejected
    return `
      <button data-action="approve" data-id="${t.id}" data-featured="false"
        class="font-body text-xs font-semibold px-3 py-1.5 rounded-full transition-all duration-200"
        style="background: rgba(0,229,160,0.12); color: var(--accent); border: 1px solid rgba(0,229,160,0.25); cursor: pointer;">
        ✅ Recuperar
      </button>
      <button data-action="delete" data-id="${t.id}"
        class="font-body text-xs font-semibold px-3 py-1.5 rounded-full transition-all duration-200"
        style="background: rgba(255,45,85,0.12); color: #ff2d55; border: 1px solid rgba(255,45,85,0.25); cursor: pointer;">
        🗑 Eliminar
      </button>
    `;
  }

  async function performAction(id, action, featured) {
    const btn = document.querySelector(`[data-action="${action}"][data-id="${id}"]`);
    const originalText = btn.innerHTML;
    btn.innerHTML = '<i class="fas fa-spinner fa-spin"></i>';
    btn.disabled = true;

    try {
      let res;
      if (action === "approve") {
        res = await fetch(`${API}/api/admin/testimonials/${id}/approve`, {
          method: "PUT",
          headers: { "Content-Type": "application/json", Authorization: `Bearer ${token}` },
          body: JSON.stringify({ featured }),
        });
      } else if (action === "reject") {
        res = await fetch(`${API}/api/admin/testimonials/${id}/reject`, {
          method: "PUT",
          headers: { Authorization: `Bearer ${token}` },
        });
      } else if (action === "delete") {
        res = await fetch(`${API}/api/admin/testimonials/${id}`, {
          method: "DELETE",
          headers: { Authorization: `Bearer ${token}` },
        });
      }

      if (res.ok) {
        await loadData();
      } else {
        alert("Error al realizar la acción");
      }
    } catch {
      alert("Error de conexión");
    }

    btn.innerHTML = originalText;
    btn.disabled = false;
  }

  // ---- Filters ----
  document.querySelectorAll(".filter-btn").forEach(btn => {
    btn.addEventListener("click", () => {
      document.querySelectorAll(".filter-btn").forEach(b => {
        b.style.background = "";
        b.style.color = "";
        b.style.border = "";
      });
      currentFilter = btn.dataset.filter;
      if (currentFilter === "all") {
        btn.style.background = "var(--accent)";
        btn.style.color = "#000";
        btn.style.border = "none";
      } else if (currentFilter === "pending") {
        btn.style.background = "rgba(255,179,0,0.15)";
        btn.style.color = "#ffb300";
        btn.style.border = "1px solid rgba(255,179,0,0.3)";
      } else if (currentFilter === "approved") {
        btn.style.background = "rgba(0,229,160,0.12)";
        btn.style.color = "var(--accent)";
        btn.style.border = "1px solid rgba(0,229,160,0.25)";
      } else if (currentFilter === "rejected") {
        btn.style.background = "rgba(255,45,85,0.12)";
        btn.style.color = "#ff2d55";
        btn.style.border = "1px solid rgba(255,45,85,0.25)";
      }
      renderTable();
    });
  });

  // ---- Source metrics ----
  function renderSourceMetrics() {
    const container = document.getElementById("source-metrics");
    const approved = allTestimonials.filter(t => t.status === "approved");
    const counts = {};
    approved.forEach(t => {
      counts[t.source] = (counts[t.source] || 0) + 1;
    });

    const labels = {
      whatsapp: "WhatsApp", instagram: "Instagram", x: "X (Twitter)",
      linkedin: "LinkedIn", github: "GitHub", referral: "Recomendación",
      google: "Google", other: "Otro",
    };

    const entries = Object.entries(counts).sort((a, b) => b[1] - a[1]);
    if (entries.length === 0) {
      container.innerHTML = `<p class="font-body text-sm col-span-full" style="color: var(--text-muted);">Aún no hay datos suficientes.</p>`;
      return;
    }

    container.innerHTML = entries.map(([key, count]) => `
      <div class="p-4 rounded-xl" style="background: rgba(255,255,255,0.03); border: 1px solid var(--border);">
        <p class="font-body text-2xl font-bold text-white">${count}</p>
        <p class="font-body text-xs" style="color: var(--text-muted);">${labels[key] || key}</p>
      </div>
    `).join("");
  }
</script>
