---
import Layout from "../layouts/Layout.astro";
import Navbar from "../components/Navbar.astro";
import Hero from "../components/Hero.astro";
import Stats from "../components/Stats.astro";
import About from "../components/About.astro";
import Projects from "../components/Projects.astro";
import WorkHistory from "../components/WorkHistory.astro";
import Teaching from "../components/Teaching.astro";
import TestimonialsSection from "../components/TestimonialsSection.astro";
import Contact from "../components/Contact.astro";
import Footer from "../components/Footer.astro";
import SocialSidebar from "../components/SocialSidebar.astro";
import { useTranslation } from "../i18n";

const lang = "es";
const t = useTranslation(lang);
---

<Layout title={t("site.title")} description={t("site.description")} lang={lang}>
  <!-- Sidebar de redes sociales (fijo, desktop) -->
  <SocialSidebar lang={lang} />

  <!-- Navegación fija -->
  <Navbar lang={lang} />

  <main>
    <Hero lang={lang} />
    <Stats lang={lang} />
    <About lang={lang} />
    <Projects lang={lang} />
    <WorkHistory lang={lang} />
    <Teaching lang={lang} />
    <TestimonialsSection lang={lang} />
    <Contact lang={lang} />
  </main>

  <Footer lang={lang} />
</Layout>