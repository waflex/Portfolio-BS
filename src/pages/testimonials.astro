---
import Layout from "../layouts/Layout.astro";
import Navbar from "../components/Navbar.astro";
import Footer from "../components/Footer.astro";
import { API_BASE } from "../lib/config";

const sources = [
  { value: "", label: "Selecciona una opción", disabled: true },
  { value: "whatsapp", label: "WhatsApp" },
  { value: "instagram", label: "Instagram" },
  { value: "x", label: "X (Twitter)" },
  { value: "linkedin", label: "LinkedIn" },
  { value: "github", label: "GitHub" },
  { value: "referral", label: "Recomendación de conocido" },
  { value: "google", label: "Google / Buscador" },
  { value: "other", label: "Otro medio" },
];
---

<Layout title="Testimonios — Jonathan Rojas | JRTdev" description="Deja tu testimonio o lee lo que otros clientes dicen sobre mi trabajo.">
  <style is:global>
    .custom-select-option:hover {
      background: rgba(0, 229, 160, 0.10);
    }
    .custom-select-option[aria-selected="true"] {
      background: rgba(0, 229, 160, 0.06);
    }
  </style>
  <Navbar />

  <main class="pt-[70px]" data-api={API_BASE}>
    <!-- Hero de la página -->
    <section class="py-20 text-center" style="background: var(--bg-dark);">
      <div class="container mx-auto px-6 lg:px-10">
        <p class="section-label mb-3 animate-fade-up stagger-1">FEEDBACK</p>
        <div class="divider-accent mx-auto mb-5"></div>
        <h1 class="font-display text-white uppercase text-5xl lg:text-7xl mb-4 animate-fade-up stagger-2">
          Testimonios
        </h1>
        <p class="font-body text-gray-400 text-base max-w-lg mx-auto animate-fade-up stagger-3">
          Me encantaría saber tu opinión. Comparte tu experiencia trabajando conmigo
          y ayuda a otros a conocerme mejor.
        </p>
      </div>
    </section>

    <!-- Formulario -->
    <section class="py-16" style="background-color: #0a0a0a;">
      <div class="container mx-auto px-6 lg:px-10 max-w-2xl">
        <div class="card-glass p-8 animate-fade-up">
          <h2 class="font-body font-bold text-white text-xl mb-6">Deja tu testimonio</h2>

          <form id="testimonialForm" class="space-y-5">
            <!-- Nombre -->
            <div>
              <label class="font-body text-xs font-medium mb-2 block" style="color: var(--text-muted);">
                Nombre *
              </label>
              <input type="text" id="field-name" required minlength="1" maxlength="60"
                     placeholder="Tu nombre" class="form-input" />
            </div>

            <!-- Email -->
            <div>
              <label class="font-body text-xs font-medium mb-2 block" style="color: var(--text-muted);">
                Correo electrónico *
              </label>
              <input type="email" id="field-email" required
                     placeholder="tu@correo.com" class="form-input" />
            </div>

            <!-- Empresa / Rol -->
            <div>
              <label class="font-body text-xs font-medium mb-2 block" style="color: var(--text-muted);">
                Empresa o Rol
              </label>
              <input type="text" id="field-company" maxlength="120"
                     placeholder="Ej: CEO de Empresa X, Estudiante IPCHILE" class="form-input" />
            </div>

            <!-- Origen -->
            <div>
              <label class="font-body text-xs font-medium mb-2 block" style="color: var(--text-muted);">
                ¿Cómo me encontraste? *
              </label>
              <!-- Custom select (reemplaza al nativo para mantener tema oscuro) -->
              <div class="custom-select relative">
                <button type="button" id="source-trigger"
                  class="form-input w-full text-left flex items-center justify-between gap-2"
                  aria-haspopup="listbox" aria-expanded="false">
                  <span id="source-value" style="color: var(--text-muted);">Selecciona una opción</span>
                  <i class="fas fa-chevron-down text-xs transition-transform duration-200" style="color: var(--text-muted);"></i>
                </button>
                <ul id="source-options" role="listbox" aria-label="Cómo me encontraste"
                  class="absolute z-50 w-full mt-1 rounded-xl overflow-hidden hidden"
                  style="background: #1a1a1a; border: 1px solid var(--border); box-shadow: 0 8px 32px rgba(0,0,0,0.5);">
                  {sources.map(s => (
                    <li role="option" aria-selected={s.disabled ? "true" : "false"}
                      data-value={s.value}
                      class="custom-select-option px-4 py-2.5 cursor-pointer text-sm transition-colors duration-150 flex items-center justify-between"
                      style="color: {s.disabled ? 'var(--text-muted)' : 'var(--text-gray)'}; {s.disabled ? 'opacity:0.5;cursor:default;' : ''}"
                      aria-disabled={s.disabled ? "true" : undefined}>
                      <span>{s.label}</span>
                      {!s.disabled && <i class="fas fa-check hidden text-xs" style="color: var(--accent);"></i>}
                    </li>
                  ))}
                </ul>
              </div>
              <input type="hidden" id="field-source" value="" required />
            </div>

            <!-- Rating -->
            <div>
              <label class="font-body text-xs font-medium mb-2 block" style="color: var(--text-muted);">
                Puntaje *
              </label>
              <div class="flex gap-2" id="star-rating">
                {[1,2,3,4,5].map(n => (
                  <button type="button" data-value={n}
                    class="star-btn w-10 h-10 rounded-lg flex items-center justify-center text-lg transition-all duration-200"
                    style="border: 1px solid var(--border-icon); color: #555;"
                    onmouseover="this.style.borderColor='#FFD700'; this.style.color='#FFD700';"
                    onmouseout="this.style.borderColor=''; this.style.color=''; if(!this.classList.contains('selected')){this.style.color='#555'; this.style.borderColor='var(--border-icon)';}">
                    <i class="fas fa-star"></i>
                  </button>
                ))}
              </div>
              <input type="hidden" id="field-rating" value="0" />
            </div>

            <!-- Mensaje -->
            <div>
              <label class="font-body text-xs font-medium mb-2 block" style="color: var(--text-muted);">
                Tu testimonio * <span class="text-xs" style="color: var(--text-muted);" id="char-count">(10-500 caracteres)</span>
              </label>
              <textarea id="field-message" required minlength="10" maxlength="500" rows="4"
                        placeholder="Cuéntame tu experiencia..." class="form-input resize-none"></textarea>
            </div>

            <!-- Consentimiento -->
            <div class="flex items-start gap-3">
              <input type="checkbox" id="field-consent" required
                     class="mt-1 w-4 h-4 rounded" style="accent-color: var(--accent);" />
              <label for="field-consent" class="font-body text-xs" style="color: var(--text-muted);">
                Autorizo la publicación de este testimonio en el portafolio de Jonathan Rojas,
                incluyendo mi nombre y empresa/rol.
              </label>
            </div>

            <!-- Status -->
            <div id="form-status" class="hidden">
              <p id="form-success"
                class="font-body text-sm text-center py-3 rounded-xl hidden"
                style="background: rgba(0,229,160,0.12); color: var(--accent); border: 1px solid rgba(0,229,160,0.3);">
                ✓ Testimonio recibido. ¡Gracias por tu feedback!
              </p>
              <p id="form-error"
                class="font-body text-sm text-center py-3 rounded-xl hidden"
                style="background: rgba(255,45,85,0.12); color: #ff2d55; border: 1px solid rgba(255,45,85,0.3);">
                ✗ Hubo un error. Por favor intenta nuevamente.
              </p>
            </div>

            <button type="submit" id="submit-btn" class="btn-accent-pill w-full justify-center">
              <i class="fas fa-paper-plane"></i>
              <span>Enviar testimonio</span>
            </button>
          </form>
        </div>
      </div>
    </section>

    <!-- Lista de testimonios aprobados -->
    <section class="py-16" style="background: var(--bg-dark);">
      <div class="container mx-auto px-6 lg:px-10">
        <h2 class="font-body font-bold text-white text-2xl mb-8 text-center">
          Testimonios <span style="color: var(--accent);">recientes</span>
        </h2>
        <div id="all-testimonials" class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6 min-h-[100px]">
          <div class="col-span-full flex items-center justify-center py-12">
            <div class="flex items-center gap-3 font-body text-sm" style="color: var(--text-muted);">
              <i class="fas fa-spinner fa-spin"></i>
              <span>Cargando testimonios...</span>
            </div>
          </div>
        </div>
      </div>
    </section>
  </main>

  <Footer />
</Layout>

<script>
  const API = document.querySelector("main").dataset.api;

  // ---- Rating stars ----
  let selectedRating = 0;
  const starBtns = document.querySelectorAll(".star-btn");
  const ratingInput = document.getElementById("field-rating");

  starBtns.forEach(btn => {
    btn.addEventListener("click", () => {
      selectedRating = parseInt(btn.dataset.value);
      ratingInput.value = selectedRating;
      starBtns.forEach((s, i) => {
        if (i < selectedRating) {
          s.style.color = "#FFD700";
          s.style.borderColor = "#FFD700";
          s.classList.add("selected");
        } else {
          s.style.color = "#555";
          s.style.borderColor = "var(--border-icon)";
          s.classList.remove("selected");
        }
      });
    });
  });

  // ---- Char counter ----
  const msgField = document.getElementById("field-message");
  const charCount = document.getElementById("char-count");
  msgField?.addEventListener("input", () => {
    const len = msgField.value.length;
    charCount.textContent = `(${len}/500 caracteres)`;
  });

  // ---- Custom Select ----
  const trigger = document.getElementById("source-trigger");
  const options = document.getElementById("source-options");
  const valueDisplay = document.getElementById("source-value");
  const hiddenInput = document.getElementById("field-source");
  const chevron = trigger?.querySelector(".fa-chevron-down");

  function closeSelect() {
    options?.classList.add("hidden");
    trigger?.setAttribute("aria-expanded", "false");
    chevron?.classList.remove("rotate-180");
  }

  function openSelect() {
    options?.classList.remove("hidden");
    trigger?.setAttribute("aria-expanded", "true");
    chevron?.classList.add("rotate-180");
  }

  trigger?.addEventListener("click", (e) => {
    e.stopPropagation();
    const isOpen = !options?.classList.contains("hidden");
    isOpen ? closeSelect() : openSelect();
  });

  document.querySelectorAll(".custom-select-option").forEach((opt) => {
    opt.addEventListener("click", () => {
      if (opt.getAttribute("aria-disabled") === "true") return;
      const val = opt.dataset.value;
      const label = opt.textContent.trim();
      valueDisplay.textContent = label;
      valueDisplay.style.color = "#fff";
      hiddenInput.value = val;
      // check icon
      document.querySelectorAll(".custom-select-option .fa-check").forEach(c => c.classList.add("hidden"));
      const check = opt.querySelector(".fa-check");
      if (check) check.classList.remove("hidden");
      closeSelect();
    });
  });

  document.addEventListener("click", (e) => {
    if (!e.target.closest(".custom-select")) closeSelect();
  });

  // Tecla Escape
  document.addEventListener("keydown", (e) => {
    if (e.key === "Escape") closeSelect();
  });

  // ---- Form submit ----
  const form = document.getElementById("testimonialForm");
  const submitBtn = document.getElementById("submit-btn");
  const formStatus = document.getElementById("form-status");
  const formSuccess = document.getElementById("form-success");
  const formError = document.getElementById("form-error");

  form?.addEventListener("submit", async (e) => {
    e.preventDefault();
    if (!submitBtn) return;

    const name = document.getElementById("field-name").value.trim();
    const email = document.getElementById("field-email").value.trim();
    const company = document.getElementById("field-company").value.trim();
    const source = document.getElementById("field-source").value;
    const rating = parseInt(ratingInput.value);
    const message = msgField.value.trim();
    const consent = document.getElementById("field-consent").checked;

    if (!name || !email || !source || rating === 0 || !message || !consent) {
      formError.querySelector("span").textContent = "Completa todos los campos obligatorios.";
      formStatus?.classList.remove("hidden");
      formError?.classList.remove("hidden");
      formSuccess?.classList.add("hidden");
      return;
    }

    if (message.length < 10) {
      formError.querySelector("span").textContent = "El testimonio debe tener al menos 10 caracteres.";
      formStatus?.classList.remove("hidden");
      formError?.classList.remove("hidden");
      formSuccess?.classList.add("hidden");
      return;
    }

    submitBtn.innerHTML = '<i class="fas fa-spinner fa-spin"></i><span>Enviando...</span>';
    (submitBtn).disabled = true;

    try {
      const res = await fetch(`${API}/api/testimonials`, {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify({ name, email, company: company || undefined, source, rating, message, consent }),
      });

      formStatus?.classList.remove("hidden");
      if (res.ok) {
        formSuccess?.classList.remove("hidden");
        formError?.classList.add("hidden");
        form.reset();
        selectedRating = 0;
        ratingInput.value = "0";
        starBtns.forEach(s => { s.style.color = "#555"; s.style.borderColor = "var(--border-icon)"; s.classList.remove("selected"); });
        charCount.textContent = "(10-500 caracteres)";
        loadApproved(); // recargar lista
      } else {
        const err = await res.json().catch(() => ({}));
        formError.querySelector("span").textContent = err.detail || "Error al enviar. Intenta nuevamente.";
        formError?.classList.remove("hidden");
        formSuccess?.classList.add("hidden");
      }
    } catch {
      formStatus?.classList.remove("hidden");
      formError.querySelector("span").textContent = "Error de conexión. Verifica tu internet.";
      formError?.classList.remove("hidden");
      formSuccess?.classList.add("hidden");
    }

    submitBtn.innerHTML = '<i class="fas fa-paper-plane"></i><span>Enviar testimonio</span>';
    (submitBtn).disabled = false;
  });

  // ---- Load approved testimonials ----
  const container = document.getElementById("all-testimonials");

  async function loadApproved() {
    try {
      const res = await fetch(`${API}/api/testimonials`);
      if (!res.ok) throw new Error();
      const data = await res.json();

      if (data.length === 0) {
        container.innerHTML = `
          <div class="col-span-full text-center py-12">
            <p class="font-body text-sm" style="color: var(--text-muted);">
              Aún no hay testimonios publicados. ¡Sé el primero!
            </p>
          </div>
        `;
        return;
      }

      container.innerHTML = data.map(t => `
        <article class="card-glass p-6 flex flex-col">
          <div class="flex gap-0.5 mb-3">
            ${Array.from({ length: 5 }, (_, i) =>
              i < t.rating
                ? '<i class="fas fa-star" style="color: #FFD700; font-size: 13px;"></i>'
                : '<i class="far fa-star" style="color: #555; font-size: 13px;"></i>'
            ).join("")}
          </div>
          <blockquote class="font-body text-sm leading-relaxed flex-grow mb-4" style="color: var(--text-gray);">
            &ldquo;${t.message}&rdquo;
          </blockquote>
          <div class="flex items-center gap-3 pt-4" style="border-top: 1px solid var(--border);">
            <div class="w-10 h-10 rounded-full flex items-center justify-center text-black text-sm font-bold flex-shrink-0"
                 style="background: var(--accent);">
              ${t.name.charAt(0).toUpperCase()}
            </div>
            <div>
              <p class="font-body text-sm font-semibold text-white">${t.name}</p>
              ${t.company ? `<p class="font-body text-xs" style="color: var(--text-muted);">${t.company}</p>` : ""}
            </div>
          </div>
        </article>
      `).join("");
    } catch {
      container.innerHTML = `
        <div class="col-span-full text-center py-12">
          <p class="font-body text-sm" style="color: var(--text-muted);">
            No se pudieron cargar los testimonios.
          </p>
        </div>
      `;
    }
  }

  loadApproved();
</script>
