---
interface Props {
  title: string;
}

const { title } = Astro.props;
import '../styles/global.css';
---

<!DOCTYPE html>
<html lang="es" data-theme="cyberpunk" class="min-h-screen">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content="Portfolio de Jonathan Rojas - Desarrollador Full Stack" />
    <title>{title}</title>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.6.0/css/all.min.css"
      integrity="sha512-Kc323vGBEqzTmouAECnVceyQqyqdsSiqLQISBL29aUW4U/M7pSPA/gEUZQqv1cwx4OnYxTxve5UMg5GT6L4JJg=="
      crossorigin="anonymous" referrerpolicy="no-referrer" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/gh/devicons/devicon@latest/devicon.min.css">
    <style>
      body {
        background: linear-gradient(to bottom right, var(--cyber-black), var(--cyber-dark));
      }
      
      /* Grid de fondo */
      body::before {
        content: "";
        position: fixed;
        top: 0;
        left: 0;
        width: 100%;
        height: 100%;
        background-image: url('/grid.webp');
        background-size: cover;
        background-repeat: repeat-y;
        opacity: 0.1;
        z-index: -2;
        pointer-events: none;
      }
      
      /* Degradado inferior */
      body::after {
        content: "";
        position: absolute;
        bottom: 0;
        left: 0;
        width: 100%;
        height: 50%;
        background: linear-gradient(to bottom, transparent, var(--cyber-black));
        z-index: -1;
        pointer-events: none;
      }
      
      /* Líneas cyberpunk */
      .cyber-lines {
        position: fixed;
        top: 0;
        left: 0;
        width: 100%;
        height: 100%;
        background: 
          linear-gradient(90deg, rgba(0, 255, 255, 0.03) 1px, transparent 1px) 0 0 / 20px 20px,
          linear-gradient(0deg, rgba(255, 45, 85, 0.03) 1px, transparent 1px) 0 0 / 20px 20px;
        z-index: -1;
        pointer-events: none;
      }
      
      /* Líneas diagonales */
      .cyber-diagonal {
        position: fixed;
        top: 0;
        left: 0;
        width: 100%;
        height: 100%;
        background: 
          linear-gradient(45deg, rgba(176, 38, 255, 0.02) 1px, transparent 1px) 0 0 / 40px 40px;
        z-index: -1;
        pointer-events: none;
      }
    </style>
    <!-- Google tag (gtag.js) -->
<script async src="https://www.googletagmanager.com/gtag/js?id=G-GP2FKK2LB1"></script>
<script>
  window.dataLayer = window.dataLayer || [];
  function gtag(){dataLayer.push(arguments);}
  gtag('js', new Date());

  gtag('config', 'G-GP2FKK2LB1');
</script>
  </head>
  <body class="min-h-screen h-full text-base-content relative">
    <div class="cyber-lines"></div>
    <div class="cyber-diagonal"></div>
    <slot />
  </body>
</html>