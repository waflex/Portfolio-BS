---
interface Props {
  title: string;
}

const { title } = Astro.props;
import "../styles/global.css";
---

<!doctype html>
<html lang="es" data-theme="cyberpunk" class="h-full">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta
      name="description"
      content="Portafolio profesional de Jonathan Rojas, Ingeniero Informático y Desarrollador Full Stack. Descubre proyectos, experiencia laboral, docencia y descarga mi CV. Especializado en .NET, JavaScript, React y soluciones tecnológicas a medida."
    />
    <meta
      name="keywords"
      content="Jonathan Rojas, Portafolio, Desarrollador Full Stack, Ingeniero Informático, .NET, JavaScript, React, REST APIs, Desarrollo Web, Chile, Proyectos, Curriculum, CV, Docente, Consultor, Freelance"
    />
    <meta name="author" content="Jonathan Rojas" />
    <meta
      property="og:title"
      content="Portafolio de Jonathan Rojas | Ingeniero Informático & Desarrollador Full Stack"
    />
    <meta
      property="og:description"
      content="Explora mi experiencia profesional, proyectos destacados y habilidades técnicas en mi portafolio personal. Descarga mi CV y contáctame para nuevos proyectos."
    />
    <meta property="og:image" content="/assets/img/Proyectos/inventario.png" />
    <meta property="og:url" content="https://jonathan-rojas.netlify.app" />
    <meta property="og:type" content="website" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content="Portafolio de Jonathan Rojas" />
    <meta
      name="twitter:description"
      content="Ingeniero Informático y Desarrollador Full Stack especializado en soluciones tecnológicas personalizadas."
    />
    <meta name="twitter:image" content="/assets/img/Proyectos/inventario.png" />
    <link rel="canonical" href="https://jonathan-rojas.netlify.app" />
    <title>{title}</title>
    <link
      rel="stylesheet"
      href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.6.0/css/all.min.css"
      integrity="sha512-Kc323vGBEqzTmouAECnVceyQqyqdsSiqLQISBL29aUW4U/M7pSPA/gEUZQqv1cwx4OnYxTxve5UMg5GT6L4JJg=="
      crossorigin="anonymous"
      referrerpolicy="no-referrer"
    />
    <link
      rel="stylesheet"
      href="https://cdn.jsdelivr.net/gh/devicons/devicon@latest/devicon.min.css"
    />
    <script type="application/ld+json">
      {
        "@context": "https://schema.org",
        "@type": "Person",
        "name": "Jonathan Rojas",
        "url": "https://jonathan-rojas.netlify.app",
        "image": "https://jonathan-rojas.netlify.app/assets/img/Proyectos/inventario.png",
        "jobTitle": "Ingeniero Informático | Desarrollador Full Stack",
        "worksFor": {
          "@type": "Organization",
          "name": "Instituto Profesional Valle Central"
        },
        "sameAs": [
          "https://www.linkedin.com/in/jonathan-rojas-532b9a146/",
          "https://github.com/waflex"
        ]
      }
    </script>

     <!-- Google tag (gtag.js) -->
    <script async src="https://www.googletagmanager.com/gtag/js?id=G-38HG1QB26H"></script>
    <script>
        window.dataLayer = window.dataLayer || [];
        function gtag() { dataLayer.push(arguments); }
        gtag('js', new Date());

        gtag('config', 'G-38HG1QB26H');
    </script>
  </head>
  <body class="min-h-full text-base-content relative">
    <div class="cyber-lines"></div>
    <div class="cyber-diagonal"></div>
    <slot />
    <script src="/assets/js/glitch.js" defer></script>
  </body>
  
</html>
